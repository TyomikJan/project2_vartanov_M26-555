[0.142, "o", "\u001b[?2004l\r\r\n"]
[0.055, "o", "***База данных***\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <и"]
[0.000, "o", "мя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n"]
[0.000, "o", "\r\nОбщие команды:"]
[0.000, "o", "\r\n"]
[0.000, "o", "<command> exit - выход из программы\r\n"]
[0.000, "o", "<command> help - справочная информация\r\n\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[1.839, "o", "create_table users name:str age:int is_active:bool"]
[0.742, "o", "\r\n"]
[0.000, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.002, "o", "\r\n>>>Введите команду: "]
[5.786, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.254, "o", "\r\n"]
[0.001, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
