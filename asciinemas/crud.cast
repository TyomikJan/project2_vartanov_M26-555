[0.454, "o", "\u001b[?2004l\r\r\n"]
[0.058, "o", "***База данных***\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <и"]
[0.000, "o", "мя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\n"]
[0.000, "o", "<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[8.496, "o", "create_table users name:str age:int is_active:bool"]
[0.367, "o", "\r\n"]
[0.002, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.004, "o", "\r\n>>>Введите команду: "]
[3.391, "o", "list_tables"]
[0.278, "o", "\r\n"]
[0.000, "o", "- users\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[3.082, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.582, "o", "\r\n"]
[0.003, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[3.532, "o", "insert into users values (\"Anna\", 25, false)"]
[0.263, "o", "\r\n"]
[0.003, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[2.698, "o", "insert into users values (\"Ivan\", 28, true)"]
[0.146, "o", "\r\n"]
[0.000, "o", "Запись с ID=3 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[2.758, "o", "select from users"]
[0.132, "o", "\r\n"]
[0.443, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n| 3  |  Ivan  |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
[2.610, "o", "select from users where age = 28"]
[0.123, "o", "\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 3  |  Ivan  |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", "\r\n>>>Введите команду: "]
